; Séance: The Unquiet Will — native Godot project
config_version=5

[application]
config/name="Séance — The Unquiet Will"
config/description="A supernatural game of testimony, inheritance, and unfinished business."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
boot_splash/image="res://assets/art/boot_splash.png"
boot_splash/bg_color=Color(0.0392157, 0.0745098, 0.0823529, 1)
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true
boot_splash/minimum_display_time=800

[autoload]
Session="*res://scripts/session.gd"
Sound="*res://scripts/sound.gd"
Voice="*res://scripts/voice.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.018, 0.021, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048

[audio]
driver/enable_input=true
driver/mix_rate=48000

[physics]
common/physics_ticks_per_second=60
